import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner input = new Scanner(System.in);

        System.out.println("Masukkan NIM mahasiswa: ");
        String nim = input.nextLine();

        System.out.println("Masukkan Nama mahasiswa: ");
        String nama = input.nextLine();

        Mahasiswa mhs = new Mahasiswa(nim, nama);

        System.out.println("\nBerapa buku yang dipinjam?");
        int jumlah = input.nextInt();
        input.nextLine(); // buang newline

        for (int i = 1; i <= jumlah; i++) {
            System.out.println("\nData Buku ke-" + i);
            System.out.print("Masukkan ISBN: ");
            String isbn = input.nextLine();
            System.out.print("Masukkan Judul Buku: ");
            String judul = input.nextLine();

            Buku buku = new Buku(isbn, judul);
            mhs.pinjam(buku);
        }

        // CETAK OUTPUT
        System.out.println("\n======================================================");
        System.out.println("NIM   : " + mhs.getNim());
        System.out.println("Nama  : " + mhs.getNama());
        System.out.println("------------------------------------------------------");
        System.out.printf("| %-3s | %-30s | %-60s |\n", "No", "ISBN", "Judul");
        System.out.println("------------------------------------------------------");

        int no = 1;
        for (Buku b : mhs.getDaftarPinjaman()) {
            System.out.printf("| %-3d | %-30s | %-60s |\n",
                    no, b.getIsbn(), b.getJudul());
            no++;
        }

        System.out.println("------------------------------------------------------");
    }
}
